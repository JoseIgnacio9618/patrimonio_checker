{
  "name": "patrimonio",
  "version": "1.0.0",
  "private": true,
  "description": "Panel privado de patrimonio e importación de Trade Republic",
  "type": "module",
  "engines": { "node": ">=24.13 <25" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.json",
    "build": "ng build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:web": "ng test --watch=false",
    "test:production": "node tests/production-smoke.mjs",
    "check": "tsc -p tsconfig.server.json --noEmit && ng build",
    "tr:connect": "tsx server/connect-cli.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "decimal.js": "^10.6.0",
    "echarts": "6.1.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "rxjs": "^7.8.2",
    "trade-republic-sdk": "0.5.0",
    "tslib": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "vitest": "^4.0.8",
    "jsdom": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
}
